{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/scan.ts": {
      "maxDuration": 60
    },
    "api/refine-deck.ts": {
      "maxDuration": 120
    },
    "api/share-preview.ts": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/assets/:art(card-back|eddies-back|legend-back)-:hash.webp",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    {
      "source": "/d/:token",
      "destination": "/api/share-preview?token=:token"
    }
  ]
}
