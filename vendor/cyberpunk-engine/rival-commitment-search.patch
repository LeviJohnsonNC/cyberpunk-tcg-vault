+// Preserve one direct comparison at a shared prefix when the branch budget
+// is crowded. Keep the leading attack's best setup alternative (or vice versa)
+// for the same host; all other slots retain their existing score order.
+function attackAndSetupBranches<T>(ordered: T[], limit: number, command: (item: T) => CommandMove): T[] {
+  const selected = ordered.slice(0, limit);
+  if (selected.length < 2 || selected.length === ordered.length) return selected;
+  for (const item of selected.slice(0, -1)) {
+    const action = command(item);
+    if (action.move !== "attackRival" && !(action.move === "playCard" && action.args?.attachToId)) continue;
+    const attackFirst = action.move === "attackRival";
+    const host = attackFirst ? action.args?.attackerId : action.args?.attachToId;
+    const sibling = ordered.find(candidate => {
+      const other = command(candidate);
+      return attackFirst
+        ? other.move === "playCard" && other.args?.attachToId === host
+        : other.move === "attackRival" && other.args?.attackerId === host;
+    });
+    if (sibling === undefined) continue;
+    if (!selected.includes(sibling)) selected[selected.length - 1] = sibling;
+    break;
+  }
+  return selected;
+}
