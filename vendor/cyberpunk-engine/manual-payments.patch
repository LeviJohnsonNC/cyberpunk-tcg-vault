+// Payable costs are computed with the same rules used by move validation.
+function buildPaymentPrompt(state: MatchState, playerId: PlayerId, moves: AvailableMove[]): PaymentPrompt | undefined {
+  if (state.G.manualPaymentPlayerId !== playerId) return undefined;
+  const player = state.G.players[playerId as string];
+  if (!player) return undefined;
+  const costs: PaymentPrompt["costs"] = {};
+  const effectGearHosts: PaymentPrompt["effectGearHosts"] = {};
+  for (const { moveId, inputSpec } of moves) {
+    switch (moveId) {
+      case "playCard":
+        if (inputSpec.type === "playCard") costs[moveId] = Object.fromEntries(
+          inputSpec.candidates.map(({ cardId }) => [cardId, {
+            amount: computeEffectiveCost(state, cardId as CardInstanceId, playerId),
+          }]),
+        );
+        break;
+      case "callLegend":
+        costs[moveId] = { action: { amount: callLegendEddieCost(state, playerId) } };
+        break;
+      case "goSolo":
+        if (inputSpec.type === "selectCard") costs[moveId] = Object.fromEntries(
+          inputSpec.candidates.map((id) => [id, { amount: goSoloCost(state, id as CardInstanceId, playerId) }]),
+        );
+        break;
+      case "activateAbility":
+        if (inputSpec.type === "selectAbility") costs[moveId] = Object.fromEntries(
+          inputSpec.candidates.map(({ cardId, abilityIndex, eddieCost }) => {
+            const ability = defOf(state.G.cardIndex[cardId]!).abilities[abilityIndex]!;
+            return [`${cardId}:${abilityIndex}`, {
+              amount: eddieCost,
+              reservedLegendIds: reservedLegendIdsForAbilityCosts(ability, state, cardId as CardInstanceId, playerId),
+            }];
+          }),
+        );
+        break;
+      case "resolveRedirectDefeat": {
+        const choice = state.G.turnMetadata.pendingChoice;
+        if (choice?.type === "redirectDefeat") costs[moveId] = { action: { amount: choice.payload.cost } };
+        break;
+      }
+      case "resolveCardToPlay": {
+        const choice = state.G.turnMetadata.pendingChoice;
+        if (choice?.type !== "chooseCardToPlay") break;
+        const entries: Record<string, PaymentCost> = {};
+        for (const id of choice.payload.cardIds) {
+          entries[id] = { amount: choice.payload.free ? 0 : computeEffectiveCost(state, id, playerId) };
+          const card = state.G.cardIndex[id as string];
+          if (!choice.payload.free && card && defOf(card).type === "gear" && !choice.payload.resolvedAttachToId) {
+            effectGearHosts[id] = pendingGearAttachHosts(state, choice, id, playerId);
+          }
+        }
+        costs[moveId] = entries;
+        break;
+      }
+    }
+  }
+  if (Object.keys(costs).length === 0) return undefined;
+  const legendIds = player.zones.legendArea.filter((id) => {
+    const card = state.G.cardIndex[id as string];
+    return card !== undefined && legendCanPayEddie(card);
+  });
+  const eddieIds = player.eddieCardIds.filter((id) => state.G.cardIndex[id as string]?.meta.spent === false);
+  return { legendIds, eddieIds, eddies: player.eddies, costs, effectGearHosts };
 }

