+/** Match each public Gig value to a distinct, least valuable legal discard. */
+export const preventGigStealResolver: ChoiceResolver<PreventGigStealChoicePrompt> = (choice, ctx) => {
+  const { stealEntries, handEntries } = choice.payload;
+  const defender = ctx.view.players[ctx.playerId];
+  const attacker = Object.entries(ctx.view.players).find(([id]) => id !== ctx.playerId)?.[1];
+  // Protect a near-winning lead or stop the theft from reaching seven Gigs.
+  const urgent = (defender?.gigCount ?? 0) >= 5
+    || (attacker?.gigCount ?? 0) + stealEntries.length >= 7
+    || ctx.view.overtimeActive || ctx.view.turnBeganWithEmptyFixer;
+  const gigValue = urgent ? 120 : 40;
+  const available = [...handEntries].sort((a, b) =>
+    defenseMaterialValue(visibleCard(ctx.view, a.cardId)) - defenseMaterialValue(visibleCard(ctx.view, b.cardId))
+    || a.cardId.localeCompare(b.cardId));
+  const preventions: Array<{ dieId: string; cardId: string }> = [];
+  for (const die of stealEntries) {
+    const index = available.findIndex(card => card.cost === die.value);
+    if (index < 0) continue;
+    const card = available[index]!;
+    if (defenseMaterialValue(visibleCard(ctx.view, card.cardId)) > gigValue) continue;
+    preventions.push({ dieId: die.dieId, cardId: card.cardId });
+    available.splice(index, 1);
+  }
+  return { kind: "command", move: "resolvePreventGigSteal",
+    args: { pass: preventions.length === 0, preventions } };
 };
