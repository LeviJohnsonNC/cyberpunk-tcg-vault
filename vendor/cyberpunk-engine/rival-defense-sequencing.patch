+import type { FilteredCardView, FilteredMatchView } from "../../view/filter.ts";
+
+/** Only identities already present in the deciding seat's projection. */
+export function visibleCard(view: FilteredMatchView, id: string) {
+  return Object.values(view.players).flatMap(player =>
+    Object.values(player.zones).flatMap(zone => Array.isArray(zone) ? zone : []),
+  ).find(card => card.instanceId === id);
+}
+
+export function defenseMaterialValue(card: FilteredCardView | undefined): number {
+  if (!card) return 0;
+  const blocker = card.keywords.includes("blocker") || card.grantedRules.includes("blocker");
+  return card.effectivePower * 3 + (card.cost ?? 0) * 2 + (blocker ? 12 : 0)
+    + card.triggerHints.length * 5 + (card.type === "unit" ? 10 : 4);
+}
