+
+/** Value a public combat opportunity when the search must stop before a private
+ * response. Discount a possible defeat; a reaction can still change the fight. */
+function combatAtResponseWindow(view: FilteredMatchView, actor: PlayerId, action: CommandMove): number {
+  if (action.move !== "attackRival" && action.move !== "attackUnit") return 0;
+  const rivalId = Object.keys(view.players).find(id => id !== actor);
+  const attacker = findCard(view, stringArg(action.args?.attackerId));
+  if (!attacker || !rivalId) return 0;
+  const rival = view.players[rivalId]!;
+  const blockable = !attacker.grantedRules.includes("cantBeBlocked") && readyBlockers(rival.zones.field).length > 0;
+  const discount = blockable ? 0.4 : 1;
+  if (action.move === "attackRival") {
+    const steals = Math.min(rival.gigCount, directStealPotential(attacker.effectivePower,
+      attacker.grantedRules.includes("stealsOneFewerGig")));
+    const own = view.players[actor]!.gigCount;
+    return own < 7 && own + steals >= 7 ? 120 * discount : 0;
+  }
+  const target = findCard(view, stringArg(action.args?.defenderId));
+  if (!target || attacker.effectivePower <= target.effectivePower) return 0;
+  // Both lines spend our attacker. Removing a second threat might deny no
+  // extra Gigs if our remaining blockers already cover it or we own only one.
+  const spentBlocker = attacker.instanceId;
+  const incoming = potentialSteals(view, rivalId, actor, true, { spentBlocker });
+  const remaining = potentialSteals(view, rivalId, actor, true, { spentBlocker, defeated: target.instanceId });
+  const material = Math.min(20, Math.max(0, target.effectivePower) + 2 * (target.cost ?? 0));
+  return (material + 32 * (incoming - remaining)) * discount;
 }

