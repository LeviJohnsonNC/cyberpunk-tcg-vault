+import type { FilteredMatchView } from "../../view/filter.ts";
+
+/** The prompt lists both axes; only the specific attacker can authorize a ready target. */
+export function isLegalFight(action: { move: string; args?: Record<string, unknown> }, view: FilteredMatchView) {
+  if (action.move !== "attackUnit") return true;
+  const fields = Object.values(view.players).flatMap(player =>
+    Array.isArray(player.zones.field) ? player.zones.field : []
+  );
+  const attacker = fields.find(card => card.instanceId === action.args?.attackerId);
+  const defender = fields.find(card => card.instanceId === action.args?.defenderId);
+  return !!attacker && !!defender && (defender.spent
+    || attacker.grantedRules.includes("canAttackReadyUnits")
+    || (attacker.grantedRules.includes("canAttackReadyBlockers") && defender.grantedRules.includes("blocker")));
+}
